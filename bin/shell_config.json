{
  "port": 8080,
  "node_name": "k8s-analyzer-node",
  "peers": [],
  "cluster_token": "k8s-analyzer-token",
  "security": {
    "allow_read_only": true,
    "command_whitelist": [
      "ls",
      "cat",
      "kubectl",
      "grep",
      "head",
      "tail",
      "wc",
      "find",
      "ps",
      "df",
      "du",
      "top",
      "netstat",
      "ss",
      "ip",
      "hostname",
      "whoami",
      "id",
      "date",
      "uptime",
      "env",
      "echo",
      "pwd",
      "which",
      "type",
      "stat",
      "file",
      "diff"
    ],
    "blacklisted_commands": [
      "rm",
      "mkfs",
      "shutdown",
      "reboot",
      "poweroff",
      "init",
      "systemctl",
      "service",
      "kill",
      "killall",
      "pkill",
      "dd",
      "fdisk",
      "parted",
      "mkswap",
      "swapon",
      "swapoff"
    ],
    "dangerous_args_regex": [
      "rm\\s+-[a-zA-Z]*r[a-zA-Z]*\\s+/",
      "dd\\s+.*of=/",
      "mkfs\\s+.*",
      "fdisk\\s+.*",
      "chmod\\s+.*777",
      "chown\\s+.*root",
      ">:\\s*/"
    ]
  },
  "log": {
    "level": "info",
    "log_dir": "./logs",
    "max_size": 100,
    "max_backups": 3,
    "max_age": 28,
    "compress": false
  }
}
